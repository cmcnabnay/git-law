{
  "name": "git-law",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "e2e": "tsx scripts/e2e/runE2E.ts",
    "test": "tsx --test packages/core/src/diff/redline.test.ts packages/core/src/diff/numberedText.test.ts packages/core/src/diff/docxPatch.test.ts packages/core/src/diff/editableRedline.test.ts packages/core/src/git/merge.test.ts packages/core/src/pr/prService.test.ts",
    "gitlaw": "tsx packages/cli/src/bin.ts",
    "dev:server": "tsx packages/server/src/main.ts",
    "dev:web": "npm run dev --workspace=@gitlaw/web"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.8.10",
    "@types/node": "^22.10.2",
    "docx": "^9.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
